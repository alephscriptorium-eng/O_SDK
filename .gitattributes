# Keep Linux-targeted operational files on LF to avoid Bash and env parsing issues.
*.sh text eol=lf
.env* text eol=lf
Dockerfile text eol=lf
Dockerfile.* text eol=lf
Caddyfile text eol=lf
*.env text eol=lf
*.env.example text eol=lf
# Configs del HUB clearnet: bind-mounts de fichero en contenedores Linux (nginx template, ssb-config, oasis-config.json).
pub/config/hub/* text eol=lf
# Sidecar de RRSS: Python y plantillas en LF (corren tambien en WSL y dentro de la obra publicada)
pub/rrss-sidecar/** text eol=lf
pub/rrss-sidecar/**/*.json text eol=lf
