# Contexto de build de la imagen Oasis (Dockerfile raíz, COPY . .).
# La imagen necesita: src/, docker-entrypoint.sh, scripts/ (parches runtime)
# y pub/tools (ssb-admin.js se ejecuta dentro del contenedor del pub).
# TODO lo demás queda fuera — en especial material de identidad y devops.
.git
.git/**
node_modules
node_modules/**
# Oasis >= 1.2: src/server/node_modules es un ENLACE a ../base/node_modules; lo crea el Dockerfile.
# src/base/node_modules SÍ viaja (son las dependencias vendorizadas): los patrones de arriba solo
# casan en la raíz del contexto.
src/server/node_modules
src/server/node_modules/**
src/server/node_modules.full
src/server/node_modules.full/**
# La pila de IA se instala en el build (OASIS_AI): lo que haya en la máquina que construye no vale
# (binarios de otra plataforma) y pesa.
src/AI/node_modules
src/AI/node_modules/**
src/AI/embeddings
src/AI/embeddings/**
src/AI/.cache
src/AI/.cache/**
src/AI/models
src/AI/models/**
volumes-dev
volumes-dev/**
backups
backups/**
.env
.env.*

# Identidad y operación remota — NUNCA dentro de la imagen
devops
devops/**
client
client/**
**/.ssh
**/.gpg

# Superficies que la imagen no necesita
archive
archive/**
docs
docs/**
ecoin
ecoin/**
.claude
.claude/**
.cursor
.cursor/**
.github
.github/**
.vscode
.vscode/**
*.png
# OJO: README.md NO se excluye — src/backend/backend.js lo lee al arrancar.
BASE-*.md
CHANGELOG.md
next-steps.md

# Del pub solo viaja lo que corre dentro del contenedor (tools/)
pub/.env
pub/.env.*
pub/data
pub/data/**
pub/site
pub/site/**
pub/site-templates
pub/site-templates/**
pub/blobstore-sidecar
pub/blobstore-sidecar/**
pub/assets
pub/assets/**

# Lore del usuario (exports de RRSS, varios GB) y su sidecar: no viajan en la imagen de Oasis
ARCHIVO/LORE
ARCHIVO/LORE/**
pub/rrss-sidecar
pub/rrss-sidecar/**
