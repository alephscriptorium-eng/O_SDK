# =============================================================================
# .env raíz — app CLIENTE (docker-compose.yml raíz) · plantilla versionada
# =============================================================================
# No hace falta copiarla a mano: «npm run client:ecoin:init» genera el .env real
# (credenciales aleatorias incluidas) y nunca pisa uno existente.
# El .env real está ignorado por git: NINGUNA credencial real entra en el repo.
# El pub NO usa este fichero (sus scripts pasan --env-file pub/.env.*).
#
# ECOin en el cliente tiene DOS MODOS (docs/CLIENT-PROTOCOL.md, «ECOin en el cliente»):
#
#   (i) SOLO DIRECCIÓN — aparecer, recibir y reclamar RBU. No corre ningún ecoind:
#       el claim es un mensaje SSB y paga el banco. Es el modo por defecto.
#         COMPOSE_PROFILES=
#         ECOIN_RPC_URL=
#       (npm run client:ecoin:init -- --mode address)
#
#   (ii) CARTERA PROPIA — saldo, envíos e historial con un ecoind propio (servicio
#        ecoin-wallet, perfil "ecoin", wallet.dat en el volumen externo
#        o-sdk-client-ecoin-data). El RPC solo existe en la red interna de Docker.
#         COMPOSE_PROFILES=ecoin
#         ECOIN_RPC_URL=http://ecoin-wallet:7474
#       (npm run client:ecoin:init -- --mode own)
#
# ADVERTENCIA: nunca apuntes ECOIN_RPC_URL al ecoind del VPS. Su RPC va en HTTP plano
# y es un monedero único sin cuentas: tu cliente operaría con el dinero del banco.
# El entrypoint solo acepta hosts locales (ecoin-wallet, localhost, 127.0.0.1,
# host.docker.internal); cualquier otro se descarta y la cartera queda desactivada.
#
# «Env manda»: lo que pongas aquí pisa al arrancar lo tecleado en /settings/wallet.
# =============================================================================

# Credenciales RPC del ecoind propio (modo ii). Las genera client:ecoin:init
# (usuario oasis-<hex8>, contraseña hex de 48). Vacías o «ecoinrpc» -> ecoin-wallet
# se niega a arrancar (fail-closed). Sirven a la vez para ecoin-wallet y oasis-client.
ECOIN_RPC_USER=
ECOIN_RPC_PASS=

# URL del RPC que usa Oasis. Vacía = modo (i): ninguna llamada RPC saliente.
# Modo (ii): http://ecoin-wallet:7474
ECOIN_RPC_URL=

# Feed SSB del banco (walletPub.pubId) al que se reclama la RBU.
# Banco del pub scriptorium (bot-2): @NYAqUzX7OACl+Fs866J8aVeKcqPxbbXccV/phcKx9UU=.ed25519
# Vacío = no se toca lo que haya en la configuración.
OASIS_WALLET_PUB_ID=

# Perfiles de Compose activos. Vacío = modo (i); «ecoin» = modo (ii).
COMPOSE_PROFILES=

# --- Opcionales (descomenta solo si los necesitas) ---------------------------
# Comisión por defecto de los envíos (wallet.fee).
#OASIS_WALLET_FEE=
# Límite de memoria del contenedor ecoin-wallet (por defecto 512m).
#ECOIN_MEM_LIMIT=512m
# «manual» = el entrypoint NO cablea la cartera: manda lo tecleado en /settings/wallet.
#OASIS_WALLET_WIRING=manual
# Escape de la guarda anti-remoto (NO recomendado; jamás para el ecoind del VPS).
#ECOIN_RPC_ALLOW_REMOTE=i-know
