{
  "name": "oasis-dockerized",
  "version": "1.0.0",
  "description": "Dockerized Oasis project.",
  "scripts": {
    "setup": "sh ./client/scripts/setup.sh",
    "build": "docker compose build",
    "build:no-cache": "docker compose build --no-cache",
    "web": "start http://localhost:3000",
    "up": "npm run setup && docker compose up -d",
    "start": "docker compose start",
    "stop": "docker compose stop",
    "downDELETEVOLS": "docker compose down -v",
    "logs": "docker compose logs -f",
    "status": "docker compose ps && docker ps",
    "restart": "docker compose restart",
    "top": "docker compose top",
    "update": "git pull && docker compose build --no-cache && docker compose up -d",
    "net": "docker network inspect o-sdk_oasis-network",
    "cleanDELETEVOLS": "docker compose down -v && docker system prune -f",
    "client:logs": "docker compose logs -f oasis-client",
    "client:shell": "docker compose exec oasis-client /bin/bash",
    "client:server-only": "docker compose run --rm -p 8008:8008 oasis-client server",
    "client:backup-keys": "sh ./client/scripts/backup-keys.sh",
    "client:test-ai": "bash ./client/scripts/test-ai-service.sh",
    "shell": "npm run client:shell",
    "backup-keys": "npm run client:backup-keys",
    "ecoin:build": "docker compose --profile ecoin build ecoin-wallet",
    "ecoin:up": "docker compose --profile ecoin up -d ecoin-wallet",
    "ecoin:start": "docker compose --profile ecoin start ecoin-wallet",
    "ecoin:stop": "docker compose --profile ecoin stop ecoin-wallet",
    "ecoin:restart": "docker compose --profile ecoin restart ecoin-wallet",
    "ecoin:logs": "docker compose --profile ecoin logs -f ecoin-wallet",
    "ecoin:status": "docker compose --profile ecoin ps ecoin-wallet",
    "ecoin:shell": "docker compose --profile ecoin exec ecoin-wallet /bin/bash",
    "ecoin:info": "docker compose --profile ecoin exec ecoin-wallet ecoind -rpcwait -rpcconnect=127.0.0.1 -rpcport=7474 -rpcuser=ecoinrpc -rpcpassword=ecoinrpc getinfo",
    "ecoin:balance": "docker compose --profile ecoin exec ecoin-wallet ecoind -rpcwait -rpcconnect=127.0.0.1 -rpcport=7474 -rpcuser=ecoinrpc -rpcpassword=ecoinrpc getbalance",
    "ecoin:address": "docker compose --profile ecoin exec ecoin-wallet ecoind -rpcwait -rpcconnect=127.0.0.1 -rpcport=7474 -rpcuser=ecoinrpc -rpcpassword=ecoinrpc getnewaddress",
    "ecoin:system": "docker exec ecoin-wallet sh -lc cat /home/ecoin/.ecoin/ecoin.conf",
    "pub:deploy": "bash ./pub/scripts/deploy.sh",
    "pub:down": "bash ./pub/scripts/down.sh",
    "pub:status": "bash ./pub/scripts/status.sh",
    "pub:logs": "bash ./pub/scripts/logs.sh",
    "pub:whoami": "bash ./pub/scripts/whoami.sh",
    "pub:invite": "bash ./pub/scripts/invite.sh",
    "pub:profile": "bash ./pub/scripts/publish-profile.sh",
    "pub:announce": "bash ./pub/scripts/announce-pub.sh",
    "pub:join": "bash ./pub/scripts/join-info.sh",
    "pub:join-client": "bash ./pub/scripts/join-client.sh",
    "pub:join-prod-client": "bash ./pub/scripts/join-prod-client.sh",
    "pub:local:up": "bash ./pub/scripts/env-run.sh .env.local deploy.sh",
    "pub:local:down": "bash ./pub/scripts/env-run.sh .env.local down.sh",
    "pub:local:status": "bash ./pub/scripts/env-run.sh .env.local status.sh",
    "pub:local:logs": "bash ./pub/scripts/env-run.sh .env.local logs.sh",
    "pub:local:whoami": "bash ./pub/scripts/env-run.sh .env.local whoami.sh",
    "pub:local:invite": "bash ./pub/scripts/env-run.sh .env.local invite.sh",
    "pub:local:profile": "bash ./pub/scripts/env-run.sh .env.local publish-profile.sh",
    "pub:local:announce": "bash ./pub/scripts/env-run.sh .env.local announce-pub.sh",
    "pub:local:join": "bash ./pub/scripts/env-run.sh .env.local join-info.sh",
    "pub:local:join-client": "bash ./pub/scripts/env-run.sh .env.local join-client.sh",
    "pub:local:maint-ui:up": "bash ./pub/scripts/env-run.sh .env.local maint-ui.sh up --stop-pub",
    "pub:local:maint-ui:down": "bash ./pub/scripts/env-run.sh .env.local maint-ui.sh down --restart-pub",
    "pub:local:maint-ui:status": "bash ./pub/scripts/env-run.sh .env.local maint-ui.sh status",
    "pub:local:maint-ui:logs": "bash ./pub/scripts/env-run.sh .env.local maint-ui.sh logs",
    "pub:local:maint-ui:urls": "bash ./pub/scripts/env-run.sh .env.local maint-ui.sh urls",
    "devops:status": "bash ./devops/scripts/deploy-status.sh",
    "devops:preflight": "bash ./devops/scripts/upgrade-preflight.sh",
    "devops:backup": "bash ./devops/scripts/backup-oasis-pub.sh",
    "devops:federation": "bash ./devops/scripts/pub-federation.sh",
    "devops:invite": "bash ./devops/scripts/generate-invite.sh",
    "devops:test-invite": "bash ./devops/scripts/test-invite.sh",
    "devops:site:deploy": "bash ./devops/scripts/deploy-site.sh",
    "pub:site:deploy": "npm run devops:site:deploy",
    "skills:sync": "node scripts/sync-claude-skills.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.1",
    "@types/node": "^24.5.2"
  },
  "devDependencies": {
    "@alephscript/skills-scriptorium": "0.x",
    "vitepress": "^1.6.4"
  }
}
