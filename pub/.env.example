# Plantilla genérica de entorno del PUB Oasis.
# Perfiles listos: .env.local.example (pruebas locales) · .env.vps.example (VPS).
# Copia una de las tres como .env (o usa env-run.sh con un fichero concreto).

# Hostname público del pub (SSB announce + web).
OASIS_PUB_HOST=localhost
OASIS_PUB_WEB_HOST=http://localhost

# Puerto SSB (público en VPS; 8009 en local para no chocar con el cliente en 8008).
OASIS_PUB_SSB_PORT=8009
OASIS_PUB_INTERNAL_SSB_PORT=8009
OASIS_PUB_SSB_CONFIG_FILE=./config/ssb/config.local
OASIS_PUB_SSB_DATA_DIR=../volumes-dev/oasis-pub/ssb-data
OASIS_PUB_LOGS_DIR=../volumes-dev/oasis-pub/logs
OASIS_PUB_CADDY_DATA_DIR=../volumes-dev/oasis-pub/caddy-data
OASIS_PUB_CADDY_CONFIG_DIR=../volumes-dev/oasis-pub/caddy-config

# Teatro (obras estáticas): el visor local sirve lo que genera el sidecar
# (npm run teatro:build) en http://localhost:8088/teatro/. En el VPS: /srv/oasis/teatro.
OASIS_PUB_TEATRO_DIR=../volumes-dev/teatro

# Puertos web.
OASIS_PUB_HTTP_PORT=8088
OASIS_PUB_HTTPS_PORT=8443

# API de panel (solo loopback).
PUB_PANEL_PORT=8788

# REQUERIDO: sustituir antes de desplegar (deploy.sh se niega con el placeholder).
PUB_PANEL_TOKEN=change-me-before-deploy

# Integración opcional de frontend.
PUB_FRONTEND_DIR=./frontend
PUB_FRONTEND_DOCKERFILE=Dockerfile
PUB_FRONTEND_PORT=8080

# Cliente Oasis local usado por los scripts de ayuda.
OASIS_CLIENT_URL=http://localhost:3000

# HUB clearnet · nodo de soporte (WP-O46, docs/PUB/HUB-PROTOCOL.md). Estado local en volumes-dev.
OASIS_HUB_SSB_DATA_DIR=../volumes-dev/oasis-hub/ssb-data
OASIS_HUB_LOGS_DIR=../volumes-dev/oasis-hub/logs
OASIS_HUB_HTTP_CACHE_DIR=../volumes-dev/oasis-hub/http-cache
OASIS_HUB_SSB_CONFIG_FILE=./config/hub/ssb-config
OASIS_HUB_OASIS_CONFIG_FILE=./config/hub/oasis-config.json
# Host que valida el backend del HUB (sin esquema; middleware compara request.hostname).
OASIS_HUB_ALLOW_HOST=localhost
HUB_CACHE_MAX_SIZE=256m
OASIS_HUB_MEM_LIMIT=1536m
OASIS_HUB_NODE_OPTIONS=--max-old-space-size=1024
# OASIS_HUB_PUBLIC=false   <- false SOLO durante el bootstrap del invite; nunca con @hub activo en Caddy

# hub-wallet (WP-O102) · ecoind + azofaifo-scriptorium-wallet-bot-2 (docs/PUB/ECOIN-PROTOCOL.md). Estado local en volumes-dev.
# Perfil compose «wallet»: pub:local:up / deploy.sh NO levantan estos servicios.
OASIS_ECOIN_DATA_DIR=../volumes-dev/ecoin
# Credenciales RPC de ecoind · genera con: openssl rand -hex 32; nunca en git
OASIS_ECOIN_RPC_USER=
OASIS_ECOIN_RPC_PASS=
OASIS_ECOIN_MEM_LIMIT=512m
OASIS_ECOIN_CPUS=0.75
OASIS_ECOIN_MAXCONNECTIONS=16
OASIS_WALLET_BOT_SSB_DATA_DIR=../volumes-dev/oasis-wallet-bot/ssb-data
OASIS_WALLET_BOT_LOGS_DIR=../volumes-dev/oasis-wallet-bot/logs
# Retirada en Oasis 1.1.4 (estado en <ssb-data>/oasis/banking). Se conserva la carpeta vieja como backup.
# OASIS_WALLET_BOT_BANKING_DIR=../volumes-dev/oasis-wallet-bot/banking
OASIS_WALLET_BOT_SSB_CONFIG_FILE=./config/wallet-bot/ssb-config
# Generado fuera de git por pub/scripts/render-wallet-bot-config.sh (lleva las credenciales RPC).
OASIS_WALLET_BOT_OASIS_CONFIG_FILE=../volumes-dev/oasis-wallet-bot/config/oasis-config.json
# motor de RBU APAGADO; encender = feed id del bot + render + recreate
# OASIS_WALLET_BOT_PUB_ID: retirada (Oasis 1.1.4 eliminó walletPub). Motor: hub-wallet.sh on|pause cambia
# OASIS_WALLET_BOT_SSB_CONFIG_FILE entre ssb-config (pub:false) y ssb-config.engine-on (pub:true).
OASIS_WALLET_BOT_MEM_LIMIT=768m
OASIS_WALLET_BOT_NODE_OPTIONS=--max-old-space-size=512
# OASIS_WALLET_BOT_PUBLIC=false   <- false SOLO durante el bootstrap del invite
