{$OASIS_PUB_WEB_HOST:pub.escrivivir.co} {
  encode zstd gzip

  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy strict-origin-when-cross-origin
  }

  @public path /public/*
  handle @public {
    reverse_proxy pub-panel-api:8787
  }

  # HUB clearnet: nodo de soporte oasis-hub detrás de la caché hub-cache.
  # /assets/* NO entero: /assets/fanzine.css es de la landing. /qr/* no se expone.
  # Desde Oasis 1.1.2 el visor usa /c/assets/* (cubierto por /c/*); /assets/{styles,themes,images} se mantiene por compatibilidad.
  @hub path /c /c/* /clearnet /assets/styles/* /assets/themes/* /assets/images/*
  handle @hub {
    reverse_proxy hub-cache:80 {
      transport http {
        dial_timeout 5s
        response_header_timeout 45s
      }
    }
  }

  handle {
    root * /srv/site
    try_files {path} {path}/index.html /index.html
    file_server
  }
}

# Scriptorium VPS — hosts aditivos del MVP.
# Edge productivo compartido: este Caddy `pub-web` de pub.
# Upstreams esperados en la red Docker `oasis_pub_net` con aliases `scriptorium-*`.

scriptorium.escrivivir.co {
  encode zstd gzip

  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
  }

  @health path /healthz
  handle @health {
    respond "scriptorium public edge ok" 200
  }

  reverse_proxy scriptorium-nodered:1880
}

