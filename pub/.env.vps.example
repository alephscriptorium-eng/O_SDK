# VPS profile for PUB OASIS SCRIPTORIUM on Debian 13.
# Canonical host layout:
#   - repo:  /opt/oasis-scriptorium
#   - state: /srv/oasis/oasis-pub

OASIS_PUB_HOST=pub.escrivivir.co
OASIS_PUB_WEB_HOST=pub.escrivivir.co

# Public SSB port.
OASIS_PUB_SSB_PORT=8008
OASIS_PUB_INTERNAL_SSB_PORT=8008
OASIS_PUB_SSB_CONFIG_FILE=./config/ssb/config
OASIS_PUB_SSB_DATA_DIR=/srv/oasis/oasis-pub/ssb-data
OASIS_PUB_LOGS_DIR=/srv/oasis/oasis-pub/logs
OASIS_PUB_CADDY_DATA_DIR=/srv/oasis/oasis-pub/caddy-data
OASIS_PUB_CADDY_CONFIG_DIR=/srv/oasis/oasis-pub/caddy-config

# Teatro (obras estáticas pesadas, p. ej. /teatro/aleph-cero).
# Se sube con devops/scripts/deploy-teatro.sh, no viaja en el repo.
OASIS_PUB_TEATRO_DIR=/srv/oasis/teatro

# Public web ports.
OASIS_PUB_HTTP_PORT=80
OASIS_PUB_HTTPS_PORT=443

# Local-only admin API port. Access via SSH/VS Code port forwarding.
PUB_PANEL_PORT=8787

# REQUIRED: replace before deploy.
PUB_PANEL_TOKEN=change-me-before-deploy

# Optional frontend integration.
PUB_FRONTEND_DIR=./frontend
PUB_FRONTEND_DOCKERFILE=Dockerfile
PUB_FRONTEND_PORT=8080

# Optional: existing Oasis client URL used by helper scripts.
OASIS_CLIENT_URL=http://localhost:3000

# HUB clearnet · nodo de soporte (WP-O46, docs/PUB/HUB-PROTOCOL.md). Estado en el volumen de datos.
OASIS_HUB_SSB_DATA_DIR=/srv/oasis/oasis-hub/ssb-data
OASIS_HUB_LOGS_DIR=/srv/oasis/oasis-hub/logs
OASIS_HUB_HTTP_CACHE_DIR=/srv/oasis/oasis-hub/http-cache
OASIS_HUB_SSB_CONFIG_FILE=./config/hub/ssb-config
OASIS_HUB_OASIS_CONFIG_FILE=./config/hub/oasis-config.json
# Host que valida el backend del HUB (sin esquema; middleware compara request.hostname).
OASIS_HUB_ALLOW_HOST=pub.escrivivir.co
HUB_CACHE_MAX_SIZE=2g
OASIS_HUB_MEM_LIMIT=1536m
OASIS_HUB_NODE_OPTIONS=--max-old-space-size=1024
# OASIS_HUB_PUBLIC=false   <- false SOLO durante el bootstrap del invite; nunca con @hub activo en Caddy

# hub-wallet (WP-O102) · ecoind + azofaifo-scriptorium-wallet-bot-2 (docs/PUB/ECOIN-PROTOCOL.md). Estado en el volumen de datos.
# Perfil compose «wallet»: pub:local:up / deploy.sh NO levantan estos servicios.
OASIS_ECOIN_DATA_DIR=/srv/oasis/ecoin
# Credenciales RPC de ecoind · genera con: openssl rand -hex 32; nunca en git
OASIS_ECOIN_RPC_USER=
OASIS_ECOIN_RPC_PASS=
OASIS_ECOIN_MEM_LIMIT=512m
OASIS_ECOIN_CPUS=0.75
OASIS_ECOIN_MAXCONNECTIONS=16
OASIS_WALLET_BOT_SSB_DATA_DIR=/srv/oasis/oasis-wallet-bot/ssb-data
OASIS_WALLET_BOT_LOGS_DIR=/srv/oasis/oasis-wallet-bot/logs
# Retirada en Oasis 1.1.4 (estado en <ssb-data>/oasis/banking). Se conserva la carpeta vieja como backup.
# OASIS_WALLET_BOT_BANKING_DIR=/srv/oasis/oasis-wallet-bot/banking
OASIS_WALLET_BOT_SSB_CONFIG_FILE=./config/wallet-bot/ssb-config
# Generado fuera de git por pub/scripts/render-wallet-bot-config.sh (lleva las credenciales RPC).
OASIS_WALLET_BOT_OASIS_CONFIG_FILE=/srv/oasis/oasis-wallet-bot/config/oasis-config.json
# motor de RBU APAGADO; encender = feed id del bot + render + recreate
OASIS_WALLET_BOT_PUB_ID=
OASIS_WALLET_BOT_MEM_LIMIT=768m
OASIS_WALLET_BOT_NODE_OPTIONS=--max-old-space-size=512
# OASIS_WALLET_BOT_PUBLIC=false   <- false SOLO durante el bootstrap del invite
