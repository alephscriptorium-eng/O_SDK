# Plantilla de instancia para devops/hosts/<nombre>/host.env
# Copia esta carpeta como devops/hosts/<mi-instancia>/ y rellena los valores.
# Actívala con: DEVOPS_HOST=<mi-instancia> npm run devops:status
# (o escribe el nombre en devops/hosts/default para hacerla permanente).
#
# REGLA: aquí solo datos NO secretos. Las claves privadas van a devops/.ssh/
# (ignorado por git) y se generan con devops/scripts/init-ssh-key.sh.

# --- Acceso SSH al host --------------------------------------------------
REMOTE_USER="${REMOTE_USER:-debian}"
REMOTE_HOST="${REMOTE_HOST:-<IP-o-dominio-del-VPS>}"
KEY_FILE="${KEY_FILE:-<nombre-clave>_ed25519}"
SSH_COMMENT="${SSH_COMMENT:-oasis-pub@<proveedor>}"

# --- Layout canónico del host ---------------------------------------------
REMOTE_REPO_ROOT="${REMOTE_REPO_ROOT:-/opt/<mi-repo>}"
REMOTE_REPO_DIR="${REMOTE_REPO_DIR:-/opt/<mi-repo>/pub}"
REMOTE_DATA_ROOT="${REMOTE_DATA_ROOT:-/srv/oasis/oasis-pub}"
REMOTE_ENV_FILE="${REMOTE_ENV_FILE:-.env.prod}"

# --- Identidad pública del pub ---------------------------------------------
PUB_CONTAINER="${PUB_CONTAINER:-oasis-pub}"
IMAGE="${IMAGE:-oasis-pub:latest}"
PUB_HOST="${PUB_HOST:-pub.<mi-dominio>}"
OUR_PUB_HOST="${OUR_PUB_HOST:-pub.<mi-dominio>}"

# --- Red SSB (ciclo vigente) -------------------------------------------------
# Cap SHS del ciclo de red al que pertenece el pub (ver directorio de pubs).
EXPECTED_SHS="${EXPECTED_SHS:-}"
# Feed del seed con el que federar (opcional).
SNH_FEED="${SNH_FEED:-}"

# --- Nodos de soporte (gates de upgrade, capacidad, cartera) -----------------
# Todo opcional: los defaults son el layout canónico del compose del pub.
# Raíz de datos de TODOS los nodos (ecoin/, oasis-hub/, oasis-wallet-bot/, src-*.tgz).
# Si no se fija, es la carpeta padre de REMOTE_DATA_ROOT.
#WALLET_DATA_ROOT="${WALLET_DATA_ROOT:-/srv/oasis}"
# Nodos que miden upgrade-gates.sh y capacity.sh: "alias:contenedor:servicio …".
# El del pub sale de PUB_CONTAINER; HUB y bot, de aquí si sus contenedores no se llaman así.
#GATE_NODES="${GATE_NODES:-pub:${PUB_CONTAINER}:oasis-pub hub:oasis-pub-hub:oasis-hub bot:oasis-pub-wallet-bot:oasis-wallet-bot}"
# Contenedor de la caché del HUB (gate `hub`).
#HUB_CACHE_CONTAINER="${HUB_CACHE_CONTAINER:-oasis-pub-hub-cache}"
