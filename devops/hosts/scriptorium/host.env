# Instancia "scriptorium" — pub Oasis del Scriptorium en un VPS Gandi (Debian 13).
# Solo datos NO secretos: la clave privada vive en devops/.ssh/ (ignorada por git).
# Patrón VAR="${VAR:-valor}": el entorno del usuario siempre tiene prioridad.

# --- Acceso SSH al host --------------------------------------------------
REMOTE_USER="${REMOTE_USER:-debian}"
REMOTE_HOST="${REMOTE_HOST:-92.243.24.163}"
KEY_FILE="${KEY_FILE:-gandi_pub_ed25519}"
SSH_COMMENT="${SSH_COMMENT:-oasis-pub-scriptorium@gandi-vps}"

# --- Layout canónico del host ---------------------------------------------
# repo:  /opt/oasis-scriptorium   ·   estado persistente: /srv/oasis/oasis-pub
REMOTE_REPO_ROOT="${REMOTE_REPO_ROOT:-/opt/oasis-scriptorium}"
REMOTE_REPO_DIR="${REMOTE_REPO_DIR:-/opt/oasis-scriptorium/pub}"
REMOTE_DATA_ROOT="${REMOTE_DATA_ROOT:-/srv/oasis/oasis-pub}"
REMOTE_ENV_FILE="${REMOTE_ENV_FILE:-.env.prod}"

# --- Identidad pública del pub ---------------------------------------------
PUB_CONTAINER="${PUB_CONTAINER:-oasis-pub-scriptorium}"
IMAGE="${IMAGE:-oasis-pub-scriptorium:latest}"
PUB_HOST="${PUB_HOST:-pub.escrivivir.co}"
OUR_PUB_HOST="${OUR_PUB_HOST:-pub.escrivivir.co}"

# --- Red SSB (ciclo vigente) -------------------------------------------------
# Cap del ciclo 6; verificado contra pub/config/ssb/config y el directorio.
EXPECTED_SHS="${EXPECTED_SHS:-H5EC+V5BU9s0lWxCkt4z8a095Sj8a6TgiLKPYi1JD7s=}"
# Seed de La Plaza (solarnethub.com), ciclo 6.
SNH_FEED="${SNH_FEED:-@0qSCyK3xyL71X4qKkmf84Cb2riP6OeUqxCvbP2Z6HWs=.ed25519}"
