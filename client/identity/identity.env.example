# Identidad GPG del usuario del cliente Oasis.
# Copia este fichero como client/identity/identity.env (ignorado por git)
# y rellena tus datos. init-gpg-key.sh lo carga automáticamente.
# Patrón VAR="${VAR:-valor}": el entorno del usuario siempre tiene prioridad.

GPG_NAME="${GPG_NAME:-<tu-alias>}"
GPG_EMAIL="${GPG_EMAIL:-<tu-alias>@<tu-dominio>}"
GPG_COMMENT="${GPG_COMMENT:-Oasis client}"
GPG_EXPORT_BASENAME="${GPG_EXPORT_BASENAME:-<tu-alias>}"
# GPG_PASSPHRASE se pasa SOLO por entorno; no la guardes en este fichero.
