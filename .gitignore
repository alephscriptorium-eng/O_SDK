node_modules/
*.gguf
*.bin
*.model

# Directorios de construcción
**/dist/
**/build/

# Volúmenes Docker - NO versionar datos persistentes
volumes/
volumes-dev/
# Nodo REAL alojado en la máquina operadora (bot retro, D-O33): fuera de los drills, jamás en git.
volumes-real/
backups/
pub/data/

# Logs
logs/
*.log

# Archivos temporales
.tmp/
temp/

# SSB - NO versionar llaves privadas ni base de datos
.ssb/
**/.ssb/

# Identidades - NUNCA versionar material de claves
**/.ssh/
**/.gpg/

# Sistema
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Configuraciones locales (todo .env* salvo las plantillas *.example)
.env
.env.*
!.env.example
!.env.*.example
config.local.json
.update_required
packages/
cache/
ecoin/ecoin_0.0.4-1_amd64.deb

# devops/: deny-by-default reforzado en devops/.gitignore
devops/backups/
devops/logs/
devops/hosts/*/.ssh/
devops/hosts/*/*.local

# client/: deny-by-default reforzado en client/.gitignore
client/.gpg/
client/identity/.gpg/
client/identity/identity.env

# Backups forenses de archivos dañados por el incidente NVMe (no versionar)
*.nul-damaged-bak

# Volcados/paste-dumps accidentales y tarballs de export (no versionar)
Opci_n_A__*
pub/*.tar.gz

# VitePress build
docs/.vitepress/dist/

# Skills: espejo derivado del paquete (@alephscript/skills-scriptorium)
# Fuente de verdad: node_modules/.../skills/ — regenerar con npm run skills:sync
.claude/skills/
.cursor/skills/
.openai/skills/

# Python bytecode
__pycache__/

# Python (pub/rrss-sidecar): bytecode, y red de seguridad contra datos dentro del sidecar
__pycache__/
*.pyc
pub/rrss-sidecar/**/store/
pub/rrss-sidecar/**/obra.json

# Oasis >= 1.2: la pila de IA y el modelo de embeddings se instalan aparte y no se versionan.
src/AI/node_modules/
src/AI/embeddings/
src/AI/.cache/
src/server/node_modules.full/
*.onnx
# Oasis >= 1.2: src/base son las dependencias que upstream vendoriza. Se versionan ENTERAS, tal
# cual vienen (D-O27): ninguna regla de arriba (node_modules/, dist/, build/, *.log, cache/,
# packages/) debe esconder un fichero suyo. Estas líneas van las últimas a propósito.
!src/base/node_modules/
!src/base/**/node_modules/
!src/base/**
